<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:text="غير متصل"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- D-Pad على اليسار -->
    <GridLayout
        android:id="@+id/dpad"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:columnCount="3"
        android:rowCount="3">

        <Space android:layout_width="60dp" android:layout_height="60dp" />
        <Button android:id="@+id/btnUp" android:layout_width="60dp" android:layout_height="60dp" android:text="▲" />
        <Space android:layout_width="60dp" android:layout_height="60dp" />

        <Button android:id="@+id/btnLeft" android:layout_width="60dp" android:layout_height="60dp" android:text="◀" />
        <Space android:layout_width="60dp" android:layout_height="60dp" />
        <Button android:id="@+id/btnRight" android:layout_width="60dp" android:layout_height="60dp" android:text="▶" />

        <Space android:layout_width="60dp" android:layout_height="60dp" />
        <Button android:id="@+id/btnDown" android:layout_width="60dp" android:layout_height="60dp" android:text="▼" />
        <Space android:layout_width="60dp" android:layout_height="60dp" />
    </GridLayout>

    <!-- أزرار A/B/X/Y على اليمين -->
    <GridLayout
        android:id="@+id/abxy"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:columnCount="3"
        android:rowCount="3">

        <Space android:layout_width="60dp" android:layout_height="60dp" />
        <Button android:id="@+id/btnX" android:layout_width="60dp" android:layout_height="60dp" android:text="X" />
        <Space android:layout_width="60dp" android:layout_height="60dp" />

        <Button android:id="@+id/btnY" android:layout_width="60dp" android:layout_height="60dp" android:text="Y" />
        <Space android:layout_width="60dp" android:layout_height="60dp" />
        <Button android:id="@+id/btnA" android:layout_width="60dp" android:layout_height="60dp" android:text="A" />

        <Space android:layout_width="60dp" android:layout_height="60dp" />
        <Button android:id="@+id/btnB" android:layout_width="60dp" android:layout_height="60dp" android:text="B" />
        <Space android:layout_width="60dp" android:layout_height="60dp" />
    </GridLayout>

    <!-- أزرار وسطية: -، +، Home، Capture، L/R، ZL/ZR -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnL" android:layout_width="70dp" android:layout_height="45dp" android:text="L" />
            <Button android:id="@+id/btnZL" android:layout_width="70dp" android:layout_height="45dp" android:text="ZL" />
            <Space android:layout_width="40dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnZR" android:layout_width="70dp" android:layout_height="45dp" android:text="ZR" />
            <Button android:id="@+id/btnR" android:layout_width="70dp" android:layout_height="45dp" android:text="R" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnMinus" android:layout_width="60dp" android:layout_height="45dp" android:text="-" />
            <Button android:id="@+id/btnCapture" android:layout_width="60dp" android:layout_height="45dp" android:text="⏺" />
            <Button android:id="@+id/btnHome" android:layout_width="60dp" android:layout_height="45dp" android:text="⌂" />
            <Button android:id="@+id/btnPlus" android:layout_width="60dp" android:layout_height="45dp" android:text="+" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
